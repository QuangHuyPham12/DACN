APP_NAME="SOLE Footwear"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sole_store
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Optional AI advisor; leave key empty for local catalog advice.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Bank transfer / VietQR: leave empty to keep COD only. Never use fictitious receiving details.
PAYMENT_BANK_BIN=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=

# Thoi han giu hang QR chua bao chuyen khoan
STORE_QR_HOLD_MINUTES=30
